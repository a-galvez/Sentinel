# =============================================================================
# Variables del stack completo (docker compose en la raíz).
# Copiar a `.env` en la raíz:  cp .env.example .env
# =============================================================================

# --- Postgres ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=SuperSecretPassword123!
POSTGRES_DB=HabitForgeDB
POSTGRES_PORT=5432

# --- API ---
API_PORT=5186
ASPNETCORE_ENVIRONMENT=Development
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- JWT (cambiar en producción, mínimo 32 caracteres) ---
JWT__Secret=cambia-esto-por-una-clave-larga-y-secreta-de-al-menos-32-caracteres
JWT__Issuer=sentinel
JWT__Audience=sentinel-web

# --- Frontend ---
WEB_PORT=5173
VITE_API_URL=http://localhost:5000/api/v1
